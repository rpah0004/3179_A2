{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 700,
    "height": 600,
    "title": "Where are Australian schools?",
    "projection": {
        "type": "mercator"
    },
    "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rpah0004/3179_A2/refs/heads/main/graph_1_symbolmap/js/ne_10m_admin_1_states_provinces.json",
        "format": 
        {
            "type": "topojson", 
            "feature": "australia_map"
        }
      },
      "mark": {
        "type": "geoshape", 
        "fill": "lightgray", 
        "stroke": "white"
        }
      },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rpah0004/3179_A2/refs/heads/main/Data/School%20Location%202025.csv"
      },
      "transform": [
        {"filter": "datum.Longitude > 112 && datum.Longitude < 154.5"}
      ],
      "mark": {
        "type": "circle", 
        "size": 8, 
        "opacity": 0.5
    },
      "encoding": {
        "longitude": {
            "field": "Longitude", 
            "type": "quantitative"
        },
        "latitude": {
          "field": "Latitude", 
          "type": "quantitative"
        },
        "color": {
          "field": "School_Sector",
          "type": "nominal",
          "title": "School Sector",
          "scale": {
            "domain": ["Government", "Catholic", "Independent"],
            "range": ["#1b9e77", "#d95f02", "#7570b3"]
          }
        },
        "tooltip": [
          {"field": "School_Name", "type": "nominal", "title": "School Name"},
          {"field": "Suburb", "type": "nominal", "title": "Suburb"},
          {"field": "State", "type": "nominal", "title": "State"},
          {"field": "School_Sector", "type": "nominal", "title": "School Sector"},
          {"field": "School_Type", "type": "nominal", "title": "School Type"}
        ]
      }
    }
  ]
}