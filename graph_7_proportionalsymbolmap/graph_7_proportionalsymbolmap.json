{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 360,
  "title": "Schools by remoteness",
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rpah0004/3179_A2/refs/heads/main/graph_7_proportionalsymbolmap/ne_10m_admin_1_states_provinces.json",
        "format": {
          "type": "topojson",
          "feature": "australia_map"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.name != 'Macquarie Island' && datum.properties.name != 'Lord Howe Island'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rpah0004/3179_A2/refs/heads/main/Data/School%20Location%202025.csv"
      },
      "transform": [
        {
          "filter": "datum.Longitude > 112 && datum.Longitude < 154.5"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "Schools"
            },
            {
              "op": "mean",
              "field": "Latitude",
              "as": "Lat"
            },
            {
              "op": "mean",
              "field": "Longitude",
              "as": "Lon"
            }
          ],
          "groupby": [
            "Statistical_Area_3_Name",
            "ABS_Remoteness_Area_Name"
          ]
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.7
      },
      "encoding": {
        "longitude": {
          "field": "Lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "Lat",
          "type": "quantitative"
        },
        "size": {
          "field": "Schools",
          "type": "quantitative",
          "scale": {
            "range": [
              5,
              400
            ]
          },
          "legend": null
        },
        "color": {
          "field": "ABS_Remoteness_Area_Name",
          "type": "ordinal",
          "title": "Remoteness",
          "scale": {
            "domain": [
              "Major Cities",
              "Inner Regional",
              "Outer Regional",
              "Remote",
              "Very Remote"
            ],
            "range": [
              "#9ecae1",
              "#6baed6",
              "#3182bd",
              "#08519c",
              "#08306b"
            ]
          }
        },
        "tooltip": [
          {
            "field": "Statistical_Area_3_Name",
            "title": "Area"
          },
          {
            "field": "ABS_Remoteness_Area_Name",
            "title": "Remoteness"
          },
          {
            "field": "Schools"
          }
        ]
      }
    }
  ]
}