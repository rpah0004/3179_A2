{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "Total schools by state and territory",
    "width": "container",
    "height": 330,
    "data": {
        "url": "https://raw.githubusercontent.com/rpah0004/3179_A2/refs/heads/main/Data/Schools%20by%20state.csv"
    },
    "mark": {
        "type": "bar",
        "color": "#3dbe12",
        "tooltip": true
    },
    "encoding": {
        "x": {
            "field": "Schools",
            "type": "quantitative",
            "title": "Number of Schools"
        },
        "y": {
            "field": "State",
            "type": "nominal",
            "sort": "-x",
            "title": null
        }
    }
}